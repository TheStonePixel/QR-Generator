{
  "name": "@stone-pixel/qr-core",
  "version": "1.0.0",
  "description": "Zero-dependency QR code generator in vanilla JavaScript",
  "license": "Apache-2.0",
  "main": "dist/qr-core.cjs.js",
  "module": "dist/qr-core.esm.js",
  "browser": "dist/qr-core.umd.js",
  "types": "dist/qr-core.d.ts",
  "exports": {
    ".": {
      "import": "./dist/qr-core.esm.js",
      "require": "./dist/qr-core.cjs.js",
      "default": "./dist/qr-core.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c"
  },
  "devDependencies": {
    "rollup": "^4.9.0",
    "rollup-plugin-terser": "^7.0.2"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "generator",
    "vanilla-js",
    "zero-dependency"
  ]
}
